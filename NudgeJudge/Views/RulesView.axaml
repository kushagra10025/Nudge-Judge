<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NudgeJudge.ViewModels"
             xmlns:v="using:NudgeJudge.Views"
             xmlns:c="using:NudgeJudge.Controls"
             x:Class="NudgeJudge.Views.RulesView"
             x:DataType="vm:RulesViewModel">

  <UserControl.Styles>
    <!-- Docked editor beside the list; on narrow pages it becomes a drawer over the list (see EditorDock) -->
    <Style Selector="Panel#EditorHost">
      <Setter Property="Grid.Column" Value="1" />
    </Style>
    <Style Selector="Border#EditorPanel">
      <Setter Property="Margin" Value="24,0,0,24" />
    </Style>
    <Style Selector="Grid#Root.narrow Panel#EditorHost">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Grid#Root.narrow Border#EditorPanel">
      <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <Style Selector="Panel#ScrimHost">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#Root.narrow Panel#ScrimHost">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Condition and group move arrows: like rule rows, hidden at rest and shown on hover and keyboard focus.
         A condition reveals them anywhere over its own fields; a group only over its header, so hovering a
         condition inside it doesn't light up the group's arrows too. Alone in its group, there's nothing to move. -->
    <Style Selector="StackPanel.move">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="StackPanel.condition:pointerover > Grid > StackPanel.move, StackPanel.condition:focus-within > Grid > StackPanel.move, Grid.group-header:pointerover > StackPanel.move, Grid.group-header:focus-within > StackPanel.move">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="StackPanel.move.alone">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- One row on the editor's track: the join word above it, and the track running on below its glyph.
         The row's own content (a condition or a group) comes from the DataTemplates below. -->
    <DataTemplate x:Key="ConditionNode" DataType="vm:ConditionNodeViewModel">
      <StackPanel>
        <Grid ColumnDefinitions="16,*" Height="28" IsVisible="{Binding ShowJoinLabel}">
          <Rectangle Width="1.5" Fill="{DynamicResource TrackBrush}" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="small" Text="{Binding JoinLabel}" FontWeight="SemiBold"
                     Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
        </Grid>
        <Grid ColumnDefinitions="16,*">
          <!-- The track continues below this glyph to the join word and the next row -->
          <Rectangle Width="1.5" Fill="{DynamicResource TrackBrush}" HorizontalAlignment="Center"
                     Margin="0,28,0,0" IsVisible="{Binding !IsLast}" />
          <ContentControl Grid.ColumnSpan="2" Content="{Binding}" HorizontalContentAlignment="Stretch" />
        </Grid>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:ConditionEditorViewModel">
      <Grid ColumnDefinitions="16,*">
        <Panel Width="16" Height="16" VerticalAlignment="Top" Margin="0,6,0,0">
          <c:MatchKindGlyph Kind="{Binding Kind.Kind}" Foreground="{DynamicResource InkMutedBrush}"
                            IsVisible="{Binding IsLink}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <c:Icon Data="{StaticResource Icon.App}" Width="14" Height="14" StrokeThickness="2"
                  Foreground="{DynamicResource InkMutedBrush}" IsVisible="{Binding IsSource}" />
        </Panel>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="6" Classes="condition" Background="Transparent">
          <!-- The spacer column, not the operator, gives way when the move arrows appear in a narrow group -->
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Operators}" SelectedItem="{Binding Operator}"
                      MinWidth="0" Padding="10,2,8,2" FontSize="12" HorizontalAlignment="Left"
                      AutomationProperties.Name="{Binding Heading, StringFormat='{}{0} operator'}" />
            <StackPanel Grid.Column="3" Classes="move" Classes.alone="{Binding IsOnly}" Orientation="Horizontal">
              <Button Classes="ghost icon" Width="24" Padding="0" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}"
                      ToolTip.Tip="Move up" AutomationProperties.Name="Move condition up">
                <c:Icon Data="{StaticResource Icon.Up}" />
              </Button>
              <Button Classes="ghost icon" Width="24" Padding="0" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}"
                      ToolTip.Tip="Move down" AutomationProperties.Name="Move condition down">
                <c:Icon Data="{StaticResource Icon.Down}" />
              </Button>
            </StackPanel>
            <Button Grid.Column="4" Classes="ghost icon danger" Command="{Binding RemoveCommand}"
                    ToolTip.Tip="Remove this condition" AutomationProperties.Name="Remove condition">
              <c:Icon Data="{StaticResource Icon.Trash}" />
            </Button>
          </Grid>

          <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch"
                    IsVisible="{Binding IsLink}" AutomationProperties.Name="Match type">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:MatchKindOption">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:MatchKindGlyph Kind="{Binding Kind}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Label}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- Alternatives, OR'd: each after the first says so inside its field -->
          <ItemsControl ItemsSource="{Binding Values}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ConditionValueViewModel">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Classes="mono" Text="{Binding Text}" IsVisible="{Binding Condition.IsLink}"
                             PlaceholderText="{Binding Condition.Placeholder}" AutomationProperties.Name="Pattern"
                         ToolTip.Tip="{Binding Condition.Hint}">
                      <TextBox.InnerLeftContent>
                        <TextBlock Classes="small faint" Text="or" Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsVisible="{Binding ShowOr}" />
                      </TextBox.InnerLeftContent>
                    </TextBox>
                    <AutoCompleteBox Classes="mono" Text="{Binding Text}" IsVisible="{Binding Condition.IsSource}"
                                     ItemsSource="{Binding Condition.KnownApps}" FilterMode="Contains" MinimumPrefixLength="0"
                                     PlaceholderText="{Binding Condition.Placeholder}" AutomationProperties.Name="Source app"
                                 ToolTip.Tip="{Binding Condition.Hint}">
                      <AutoCompleteBox.InnerLeftContent>
                        <TextBlock Classes="small faint" Text="or" Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsVisible="{Binding ShowOr}" />
                      </AutoCompleteBox.InnerLeftContent>
                    </AutoCompleteBox>
                    <Button Grid.Column="1" Classes="ghost icon" Margin="4,0,0,0" Command="{Binding RemoveCommand}"
                            IsVisible="{Binding CanRemove}" ToolTip.Tip="Remove this alternative"
                            AutomationProperties.Name="Remove alternative">
                      <c:Icon Data="{StaticResource Icon.Close}" />
                    </Button>
                  </Grid>
                  <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="Auto,*">
            <Button Classes="ghost" Padding="6,2" Margin="-6,0,0,0" FontSize="12" Command="{Binding AddValueCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <c:Icon Data="{StaticResource Icon.Plus}" Width="12" Height="12" />
                <TextBlock Text="{Binding AddValueLabel}" />
              </StackPanel>
            </Button>
            <CheckBox Grid.Column="1" Content="Match case" IsChecked="{Binding CaseSensitive}" FontSize="12"
                      IsVisible="{Binding ShowCaseSensitive}" HorizontalAlignment="Right" MinHeight="0" />
          </Grid>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- A group: the branch glyph on the parent's track, an all/any header, and its rows inset on their own track -->
    <DataTemplate DataType="vm:ConditionGroupViewModel">
      <Grid ColumnDefinitions="16,*">
        <Panel Width="16" Height="16" VerticalAlignment="Top" Margin="0,6,0,0">
          <c:Icon Data="{StaticResource Icon.Branch}" Width="16" Height="16" StrokeThickness="2"
                  Foreground="{DynamicResource InkMutedBrush}" />
        </Panel>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="6">
          <Grid Classes="group-header" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" MinHeight="28" Background="Transparent">
            <TextBlock Text="Match" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Joins}" SelectedItem="{Binding Join}" MinWidth="0"
                      Padding="10,2,8,2" FontSize="12" AutomationProperties.Name="Match all or any in this group" />
            <TextBlock Grid.Column="2" Classes="small muted" Text="of these" VerticalAlignment="Center" Margin="6,0,0,0" />
            <StackPanel Grid.Column="4" Classes="move" Classes.alone="{Binding IsOnly}" Orientation="Horizontal">
              <Button Classes="ghost icon" Width="24" Padding="0" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}"
                      ToolTip.Tip="Move up" AutomationProperties.Name="Move group up">
                <c:Icon Data="{StaticResource Icon.Up}" />
              </Button>
              <Button Classes="ghost icon" Width="24" Padding="0" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}"
                      ToolTip.Tip="Move down" AutomationProperties.Name="Move group down">
                <c:Icon Data="{StaticResource Icon.Down}" />
              </Button>
            </StackPanel>
            <Button Grid.Column="5" Classes="ghost icon danger" Command="{Binding RemoveCommand}"
                    ToolTip.Tip="Remove this group and everything in it" AutomationProperties.Name="Remove group">
              <c:Icon Data="{StaticResource Icon.Trash}" />
            </Button>
          </Grid>

          <!-- The group's own line runs from its first row down to its add row, so the add buttons
               visibly belong to this group and not to the one around it -->
          <Grid RowDefinitions="Auto,Auto,Auto">
            <Rectangle Grid.RowSpan="3" Width="1.5" Fill="{DynamicResource TrackBrush}" HorizontalAlignment="Left"
                       Margin="7.25,14,0,12" />
            <ItemsControl Classes="nested" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ConditionNode}" />

            <TextBlock Grid.Row="1" Classes="body faint small" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap"
                       Margin="26,4,0,0" Text="This group is empty. Add a condition to it, or remove the group." />

            <Rectangle Grid.Row="2" Width="10" Height="1.5" Fill="{DynamicResource TrackBrush}" HorizontalAlignment="Left"
                       VerticalAlignment="Center" Margin="8,6,0,0" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="2" Margin="20,6,0,0">
              <Button Classes="ghost" Padding="6,2" FontSize="12" Command="{Binding AddLinkConditionCommand}"
                      ToolTip.Tip="Add a link condition to this group" AutomationProperties.Name="{Binding AddLinkName}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <c:Icon Data="{StaticResource Icon.Plus}" Width="12" Height="12" />
                  <TextBlock Text="Link" />
                </StackPanel>
              </Button>
              <Button Classes="ghost" Padding="6,2" FontSize="12" Command="{Binding AddSourceConditionCommand}"
                      ToolTip.Tip="Add an opened-from condition to this group" AutomationProperties.Name="{Binding AddSourceName}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <c:Icon Data="{StaticResource Icon.Plus}" Width="12" Height="12" />
                  <TextBlock Text="Opened from" />
                </StackPanel>
              </Button>
              <Button Classes="ghost" Padding="6,2" FontSize="12" Command="{Binding AddGroupCommand}"
                      IsVisible="{Binding CanAddGroup}"
                      ToolTip.Tip="Add a group inside this one" AutomationProperties.Name="{Binding AddGroupName}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <c:Icon Data="{StaticResource Icon.Plus}" Width="12" Height="12" />
                  <TextBlock Text="Group" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid x:Name="Root" ColumnDefinitions="*,Auto" Margin="32,28,32,0">

    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto">

      <!-- Header: creating rules is the page's job; testing is the secondary action -->
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,20">
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="Rules" />
          <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Margin="0,0,16,0"
                     Text="The first rule that matches a link picks its browser." />
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding ToggleTesterCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
                IsVisible="{Binding HasRules}" HotKey="Ctrl+T" ToolTip.Tip="Check which rule a link would hit (Ctrl+T)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Data="{StaticResource Icon.Search}" />
            <TextBlock Text="Test a link" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="accent" Command="{Binding NewRuleCommand}" VerticalAlignment="Center"
                IsVisible="{Binding HasRules}" HotKey="Ctrl+N" ToolTip.Tip="New rule (Ctrl+N)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Data="{StaticResource Icon.Plus}" />
            <TextBlock Text="New rule" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Notices -->
      <StackPanel Grid.Row="1" Spacing="8">
        <Border Classes="notice stop" IsVisible="{Binding ShowRoutingOff}" Margin="0,0,0,8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Ellipse Classes="lamp" />
            <TextBlock Grid.Column="1" Classes="text" Text="{Binding RoutingOffNotice}" />
            <Button Grid.Column="2" Classes="ghost" Content="Turn routing on" Command="{Binding TurnOnRoutingCommand}" Margin="12,0,0,0" />
          </Grid>
        </Border>
        <Border Classes="notice" IsVisible="{Binding HasSampleRules}" Margin="0,0,0,8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Ellipse Classes="lamp" />
            <TextBlock Grid.Column="1" Classes="text"
                       Text="Rules marked Sample are examples. Save one in the editor to keep it." />
            <Button Grid.Column="2" Classes="ghost" Content="Remove samples" Command="{Binding RemoveSamplesCommand}" Margin="12,0,0,0" />
          </Grid>
        </Border>
      </StackPanel>

      <TextBlock Grid.Row="2" Classes="label muted" Text="Checked top to bottom" Margin="12,4,0,8"
                 IsVisible="{Binding HasRules}" />

      <!-- Rule list -->
      <ScrollViewer Grid.Row="3" Padding="0,0,0,24">
        <Panel>

          <!-- First run: the user decides whether to start from samples -->
          <!-- Full width like the lists; only the text measure is capped -->
          <Border Classes="surface" Padding="24,22" Margin="0,8,0,0" VerticalAlignment="Top"
                  IsVisible="{Binding ShowWelcome}">
            <StackPanel Spacing="16">
              <StackPanel Spacing="6" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Classes="h2" Text="How would you like to start?" />
                <TextBlock Classes="body muted"
                           Text="Rules decide which browser opens each link. Start with an empty list and build your own, or load a sample setup to see how rules and browsers work together first." />
                <TextBlock Classes="body muted"
                           Text="Samples are marked as such and can be removed at any time. Scanning for your installed browsers replaces them." />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding StartEmptyCommand}" Content="Start empty" />
                <Button Command="{Binding LoadSamplesCommand}" Content="Load sample setup" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- No rules yet: the three steps that get links routing -->
          <StackPanel IsVisible="{Binding ShowSetup}" Margin="0,4,0,0" VerticalAlignment="Top">
            <TextBlock Classes="h2" Text="Get links routing" Margin="12,0,0,4" />
            <TextBlock Classes="body muted" Margin="12,0,0,16" MaxWidth="640" HorizontalAlignment="Left"
                       Text="Three steps. After that, links from other apps go straight to the right browser." />

            <Border Classes="row" Padding="12,12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="junction" Classes.done="{Binding HasBrowsers}" Margin="0,0,14,0" VerticalAlignment="Top">
                  <Panel>
                    <TextBlock Text="1" IsVisible="{Binding NeedsBrowsers}" />
                    <c:Icon Data="{StaticResource Icon.Check}" IsVisible="{Binding HasBrowsers}" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
                  <TextBlock Text="Find your browsers" FontWeight="SemiBold" />
                  <TextBlock Classes="small muted" Text="{Binding BrowsersStepDetail}" TextWrapping="Wrap" />
                </StackPanel>
                <Panel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                  <Button Classes="accent" Command="{Binding FindBrowsersCommand}" IsVisible="{Binding NeedsBrowsers}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Data="{StaticResource Icon.Browsers}" />
                      <TextBlock Text="Find browsers" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost" Content="Scan again" Command="{Binding FindBrowsersCommand}" IsVisible="{Binding HasBrowsers}" />
                </Panel>
              </Grid>
            </Border>

            <Border Classes="row" Padding="12,12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="junction" Margin="0,0,14,0" VerticalAlignment="Top">
                  <TextBlock Text="2" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
                  <TextBlock Text="Add your first rule" FontWeight="SemiBold" />
                  <TextBlock Classes="small muted" TextWrapping="Wrap"
                             Text="A pattern and the browser it opens in. The chooser can also save one when you pick ‘Always’." />
                </StackPanel>
                <Button Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Classes.accent="{Binding HasBrowsers}"
                        Command="{Binding NewRuleCommand}" IsEnabled="{Binding HasBrowsers}" HotKey="Ctrl+N">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Data="{StaticResource Icon.Plus}" />
                    <TextBlock Text="Add rule" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Border Classes="row" Padding="12,12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="junction" Classes.done="{Binding Settings.IsRegistered}" Margin="0,0,14,0" VerticalAlignment="Top">
                  <Panel>
                    <TextBlock Text="3" IsVisible="{Binding Settings.NeedsSetup}" />
                    <c:Icon Data="{StaticResource Icon.Check}" IsVisible="{Binding Settings.IsRegistered}" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
                  <TextBlock Text="Make NudgeJudge your default browser" FontWeight="SemiBold" />
                  <TextBlock Classes="small muted" TextWrapping="Wrap"
                             Text="So links from mail, chat and the terminal come here first." />
                </StackPanel>
                <Button Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Content="Open setup"
                        Command="{Binding OpenSetupCommand}" IsVisible="{Binding Settings.NeedsSetup}" />
              </Grid>
            </Border>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Rules}" Classes.paused="{Binding ShowRoutingOff}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:RuleItemViewModel">
                <Border Classes="row" Classes.match="{Binding IsTestMatch}" Classes.editing="{Binding IsEditing}" Margin="0,0,0,2">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                    <Border Classes="junction" Classes.lit="{Binding IsTestMatch}" Margin="0,0,14,0">
                      <TextBlock Text="{Binding Number}" />
                    </Border>

                    <!-- The name leads; the conditions read underneath as one line -->
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Classes.dimmed="{Binding IsDimmed}">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Name}" />
                      <c:ConditionSummary Parts="{Binding Summary}" FontSize="12" Foreground="{DynamicResource InkFaintBrush}"
                                          GlyphBrush="{DynamicResource InkMutedBrush}" ValueBrush="{DynamicResource InkMutedBrush}"
                                          ToolTip.Tip="{Binding SummaryText}" />
                      <WrapPanel Margin="0,3,0,0" ItemSpacing="6" LineSpacing="4" IsVisible="{Binding HasBadges}">
                        <Border Classes="badge" IsVisible="{Binding IsTemporary}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <c:Icon Data="{StaticResource Icon.Clock}" />
                            <TextBlock Text="{Binding ExpiryText}" />
                          </StackPanel>
                        </Border>
                        <Border Classes="badge" IsVisible="{Binding IsSample}">
                          <TextBlock Text="Sample" />
                        </Border>
                      </WrapPanel>
                      <TextBlock Classes="error" Margin="0,1,0,0" Text="{Binding RuleError}" TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RuleError}" IsVisible="{Binding HasRuleError}" />
                      <!-- The destination already says "Missing browser" in red; the row offers the fix -->
                      <Button Classes="ghost" Padding="6,1" Margin="-6,0,0,0" FontSize="12" HorizontalAlignment="Left"
                              Content="Pick a browser" Command="{Binding EditCommand}" IsVisible="{Binding ShowBrowserFix}"
                              ToolTip.Tip="This rule's browser was removed" />
                    </StackPanel>

                    <!-- Destination: fixed width so destinations align down the list -->
                    <Grid Grid.Column="2" ColumnDefinitions="Auto,*" Width="172" Margin="16,0,8,0" VerticalAlignment="Center"
                          Classes.dimmed="{Binding IsDimmed}">
                      <c:Icon Data="{StaticResource Icon.Arrow}" Width="14" Height="14" Margin="0,0,10,0"
                              Foreground="{DynamicResource InkFaintBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding BrowserName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                 Classes.error="{Binding BrowserMissing}" VerticalAlignment="Center" ToolTip.Tip="{Binding BrowserName}" />
                    </Grid>

                    <ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled}" OnContent="" OffContent="" MinWidth="0"
                                  VerticalAlignment="Center" Margin="0,0,4,0"
                                  ToolTip.Tip="Enable or disable this rule" AutomationProperties.Name="Rule enabled" />

                    <!-- Shown on hover, keyboard focus and while editing (Styles.axaml) -->
                    <StackPanel Grid.Column="4" Classes="actions" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                      <Button Classes="ghost icon" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}"
                              ToolTip.Tip="Move up" AutomationProperties.Name="Move up">
                        <c:Icon Data="{StaticResource Icon.Up}" />
                      </Button>
                      <Button Classes="ghost icon" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}"
                              ToolTip.Tip="Move down" AutomationProperties.Name="Move down">
                        <c:Icon Data="{StaticResource Icon.Down}" />
                      </Button>
                      <Button Classes="ghost icon" Command="{Binding EditCommand}" ToolTip.Tip="Edit" AutomationProperties.Name="Edit rule">
                        <c:Icon Data="{StaticResource Icon.Edit}" />
                      </Button>
                      <Button Classes="ghost icon danger" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete"
                              AutomationProperties.Name="Delete rule">
                        <c:Icon Data="{StaticResource Icon.Trash}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
      </ScrollViewer>

      <!-- Tester: opened on demand, docked under the list -->
      <Border Grid.Row="4" x:Name="TesterDock" Classes="surface" Padding="16,12,12,12" Margin="0,0,0,24"
              IsVisible="{Binding ShowTester}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="Test a link" />
              <TextBlock Classes="small faint" Text="See which rule would catch it" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost icon" Command="{Binding ToggleTesterCommand}" ToolTip.Tip="Close tester"
                    AutomationProperties.Name="Close tester">
              <c:Icon Data="{StaticResource Icon.Close}" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,4,0">
            <TextBox x:Name="TestUrlBox" Classes="mono" Text="{Binding TestUrl}"
                     PlaceholderText="Paste a link, e.g. https://jira.acme.io/browse/OPS-1"
                     AutomationProperties.Name="Test link">
              <TextBox.InnerLeftContent>
                <c:Icon Data="{StaticResource Icon.Search}" Margin="10,0,2,0" Foreground="{DynamicResource InkFaintBrush}" />
              </TextBox.InnerLeftContent>
            </TextBox>
            <!-- Optional: rules can depend on the app a link came from -->
            <AutoCompleteBox Grid.Column="1" Classes="mono" Width="200" Margin="8,0,0,0" Text="{Binding TestSource}"
                             ItemsSource="{Binding KnownApps}" FilterMode="Contains" MinimumPrefixLength="0"
                             PlaceholderText="From any app" AutomationProperties.Name="Test source app"
                             ToolTip.Tip="Test as if the link came from this app, e.g. ms-teams.exe">
              <AutoCompleteBox.InnerLeftContent>
                <c:Icon Data="{StaticResource Icon.App}" Margin="10,0,2,0" Foreground="{DynamicResource InkFaintBrush}" />
              </AutoCompleteBox.InnerLeftContent>
            </AutoCompleteBox>
            <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding SendTestToChooserCommand}"
                    ToolTip.Tip="Open this link in the chooser, as if no rule matched">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{StaticResource Icon.Open}" />
                <TextBlock Text="Try in chooser" />
              </StackPanel>
            </Button>
          </Grid>

          <c:RouteDiagram Stops="{Binding TestStops}" Destination="{Binding TestDestination}"
                          IsIdle="{Binding TestIdle}" TerminalLabel="Ask me" Margin="0,0,4,0" />

          <StackPanel Spacing="2">
            <TextBlock Text="{Binding TestHeadline}" FontWeight="SemiBold" TextWrapping="Wrap"
                       Classes.error="{Binding TestInvalid}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding TestDetail}" Classes="mono faint small" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding TestDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Narrow pages: dim the list behind the editor drawer -->
    <Panel x:Name="ScrimHost" Grid.ColumnSpan="2" Margin="-32,-28,-32,0">
      <Border x:Name="Scrim" Classes="scrim" IsVisible="{Binding Editor.IsOpen}" />
    </Panel>

    <!-- Editor -->
    <Panel x:Name="EditorHost" Grid.Row="0" DataContext="{Binding Editor}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border x:Name="EditorPanel" Classes="panel" Width="360" Padding="20" VerticalAlignment="Top"
            IsVisible="{Binding IsOpen}" x:DataType="vm:RuleEditorViewModel">
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="h2" Text="{Binding Title}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost icon" Command="{Binding CancelCommand}" ToolTip.Tip="Close"
                  AutomationProperties.Name="Close editor" HotKey="Escape">
            <c:Icon Data="{StaticResource Icon.Close}" />
          </Button>
        </Grid>

        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="Name" />
          <TextBox Text="{Binding Name}" PlaceholderText="e.g. YouTube from Teams" AutomationProperties.Name="Rule name"
                   MaxLength="120" />
          <TextBlock Classes="error" Text="{Binding NameError}" IsVisible="{Binding HasNameError}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Conditions sit on a track, like junctions on the line; the join word sits on the track between them.
             A group is a siding: its own all/any header, and its conditions on their own track, inset. -->
        <StackPanel Spacing="8">
        <StackPanel Spacing="8" DataContext="{Binding Root}" x:DataType="vm:ConditionGroupViewModel">
          <Grid ColumnDefinitions="*,Auto" MinHeight="28">
            <TextBlock Classes="label" Text="When" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowJoin}">
              <TextBlock Classes="small muted" Text="Match" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Joins}" SelectedItem="{Binding Join}" MinWidth="0" Padding="10,2,8,2"
                        FontSize="12" AutomationProperties.Name="Match all or any conditions" />
              <TextBlock Classes="small muted" Text="of these" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ConditionNode}" />

          <TextBlock Classes="body faint small" Text="{Binding Owner.RuleError}" IsVisible="{Binding Owner.HasRuleError}" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Command="{Binding AddLinkConditionCommand}" Padding="10,4" FontSize="12"
                    ToolTip.Tip="Add a condition on the link" AutomationProperties.Name="{Binding AddLinkName}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{StaticResource Icon.Plus}" Width="12" Height="12" />
                <TextBlock Text="Link" />
              </StackPanel>
            </Button>
            <Button Command="{Binding AddSourceConditionCommand}" Padding="10,4" FontSize="12"
                    ToolTip.Tip="Add a condition on the app the link was opened from"
                    AutomationProperties.Name="{Binding AddSourceName}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{StaticResource Icon.Plus}" Width="12" Height="12" />
                <TextBlock Text="Opened from" />
              </StackPanel>
            </Button>
            <Button Command="{Binding AddGroupCommand}" Padding="10,4" FontSize="12"
                    ToolTip.Tip="Add a group of conditions with its own all/any, e.g. this app or that one"
                    AutomationProperties.Name="{Binding AddGroupName}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{StaticResource Icon.Plus}" Width="12" Height="12" />
                <TextBlock Text="Group" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="6"
                      IsVisible="{Binding TestVerdict, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Panel Width="8" Height="8" VerticalAlignment="Center">
              <Ellipse Fill="{DynamicResource ProceedBrush}" IsVisible="{Binding TestVerdictMatches}" />
              <Ellipse Fill="{DynamicResource LineStrongBrush}" IsVisible="{Binding !TestVerdictMatches}" />
            </Panel>
            <TextBlock Classes="small muted" Text="{Binding TestVerdict}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="Open in" />
          <ComboBox ItemsSource="{Binding Browsers}" SelectedItem="{Binding Browser}" HorizontalAlignment="Stretch"
                    PlaceholderText="Choose a browser" AutomationProperties.Name="Open in">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:BrowserOption">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Classes="faint small" Text="{Binding Detail}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="body faint small" IsVisible="{Binding HasNoBrowsers}"
                     Text="No browsers yet. Add or scan for them on the Browsers page." />
        </StackPanel>

        <Border Classes="badge route" Padding="10,8" CornerRadius="6" IsVisible="{Binding IsTemporary}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ExpiryText, StringFormat='Temporary rule · {0}'}" VerticalAlignment="Center" FontSize="12" />
            <Button Grid.Column="1" Classes="ghost" Padding="8,2" Content="Make permanent" Command="{Binding MakePermanentCommand}" FontSize="12" />
          </Grid>
        </Border>

        <Rectangle Classes="divider" />

        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" />
          <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
          <Button Grid.Column="3" Classes="accent" Content="Save rule" Command="{Binding SaveCommand}" IsDefault="True" />
        </Grid>
      </StackPanel>
    </Border>
    </ScrollViewer>
    </Panel>

    <v:UndoToast Grid.ColumnSpan="2" DataContext="{Binding Undo}" />
  </Grid>
</UserControl>
