<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NudgeJudge.ViewModels"
        xmlns:c="using:NudgeJudge.Controls"
        x:Class="NudgeJudge.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/nudgejudge.png"
        Title="NudgeJudge"
        Width="1200" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="224,*">

    <!-- Signalling panel -->
    <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelLineBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="12,20,12,12">

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,24">
          <c:Icon Data="{StaticResource Icon.Rules}" Width="22" Height="22" StrokeThickness="2.2"
                  Foreground="{StaticResource PanelLampBrush}" />
          <TextBlock Text="NudgeJudge" FontSize="17" FontWeight="Bold" LetterSpacing="-0.2"
                     Foreground="{StaticResource PanelInkBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <ListBox Grid.Row="1" Classes="nav" SelectedIndex="{Binding SelectedPageIndex}"
                 AutomationProperties.Name="Sections">
          <ListBoxItem>
            <Grid ColumnDefinitions="10,Auto,*">
              <Ellipse Classes="lamp" Width="5" Height="5" HorizontalAlignment="Left" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <c:Icon Data="{StaticResource Icon.Rules}" />
                <TextBlock Text="Rules" />
              </StackPanel>
            </Grid>
          </ListBoxItem>
          <ListBoxItem>
            <Grid ColumnDefinitions="10,Auto,*">
              <Ellipse Classes="lamp" Width="5" Height="5" HorizontalAlignment="Left" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <c:Icon Data="{StaticResource Icon.Browsers}" />
                <TextBlock Text="Browsers" />
              </StackPanel>
            </Grid>
          </ListBoxItem>
          <ListBoxItem>
            <Grid ColumnDefinitions="10,Auto,*">
              <Ellipse Classes="lamp" Width="5" Height="5" HorizontalAlignment="Left" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <c:Icon Data="{StaticResource Icon.Activity}" />
                <TextBlock Text="Activity" />
              </StackPanel>
            </Grid>
          </ListBoxItem>
          <ListBoxItem>
            <Grid ColumnDefinitions="10,Auto,*">
              <Ellipse Classes="lamp" Width="5" Height="5" HorizontalAlignment="Left" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <c:Icon Data="{StaticResource Icon.Settings}" />
                <TextBlock Text="Settings" />
              </StackPanel>
            </Grid>
          </ListBoxItem>
        </ListBox>

        <!-- Routing signal: not receiving links, then on / off -->
        <Border Grid.Row="2" Background="{StaticResource PanelRaisedBrush}" CornerRadius="8" Padding="12">
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
            <Panel Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top">
              <Ellipse Fill="{StaticResource PanelProceedBrush}" IsVisible="{Binding Settings.SignalOn}" />
              <Ellipse Fill="{StaticResource PanelStopBrush}" IsVisible="{Binding Settings.SignalOff}" />
              <Ellipse Stroke="{StaticResource PanelMutedBrush}" StrokeThickness="2" IsVisible="{Binding Settings.NeedsSetup}" />
            </Panel>
            <TextBlock Grid.Column="1" Text="{Binding Settings.SignalLabel}" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource PanelInkBrush}" />
            <ToggleSwitch Grid.Column="2" Grid.RowSpan="2" IsChecked="{Binding Settings.RoutingEnabled}"
                          OnContent="" OffContent="" MinWidth="0" Margin="0,-6,-8,0" VerticalAlignment="Top"
                          ToolTip.Tip="Route links by rules" AutomationProperties.Name="Route links by rules">
              <!-- The panel is dark in every theme, so the switch uses panel ink rather than the page's -->
              <ToggleSwitch.Resources>
                <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#DCE8E1" />
                <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#F2F7F4" />
                <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#C3D3CA" />
                <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#DCE8E1" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0F1F18" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0F1F18" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0F1F18" />
                <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#21382E" />
                <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#8DA89A" />
                <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#DCE8E1" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#8DA89A" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#DCE8E1" />
              </ToggleSwitch.Resources>
            </ToggleSwitch>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Settings.SignalDetail}" FontSize="12"
                       TextWrapping="Wrap" Foreground="{StaticResource PanelMutedBrush}" Margin="0,2,0,0" />
            <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="panel-link" Content="Set up"
                    Command="{Binding OpenSetupCommand}" IsVisible="{Binding Settings.NeedsSetup}" Margin="0,8,0,0" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- Work area -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0" IsVisible="{Binding HasConfigProblem}" Background="{DynamicResource StopSoftBrush}" Padding="24,10">
        <TextBlock Text="{Binding ConfigProblem}" Foreground="{DynamicResource StopBrush}" TextWrapping="Wrap" FontSize="13" />
      </Border>
      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
  </Grid>
</Window>
