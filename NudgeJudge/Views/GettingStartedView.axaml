<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NudgeJudge.ViewModels"
             xmlns:c="using:NudgeJudge.Controls"
             x:Class="NudgeJudge.Views.GettingStartedView"
             x:DataType="vm:GettingStartedViewModel">

  <UserControl.Styles>
    <!-- Step numbers sit level with the step's title and button, not at the top of a wrapped description -->
    <Style Selector="Border.step Border.junction">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,14,0" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Padding="32,28,32,24">
    <StackPanel>

      <StackPanel Spacing="4" Margin="0,0,0,20">
        <TextBlock Classes="h1" Text="Get started" />
        <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                   Text="NudgeJudge sits between your apps and your browsers, and sends each link to the right one." />
      </StackPanel>

      <!-- First run: the user decides whether to start from samples -->
      <Border Classes="surface" Padding="24,22" Margin="0,0,0,24" IsVisible="{Binding Rules.ShowWelcome}">
        <StackPanel Spacing="16">
          <StackPanel Spacing="6" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Classes="h2" Text="How would you like to start?" />
            <TextBlock Classes="body muted" TextWrapping="Wrap"
                       Text="Rules decide which browser opens each link. Start with an empty list and build your own, or load a sample setup to see how rules and browsers work together first." />
            <TextBlock Classes="body muted" TextWrapping="Wrap"
                       Text="Samples are marked as such and can be removed at any time. Finding your installed browsers replaces them." />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Command="{Binding Rules.StartEmptyCommand}" Content="Start empty" />
            <Button Command="{Binding Rules.LoadSamplesCommand}" Content="Load sample setup" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Everything done: say so, and point at where the work happens from now on -->
      <Border Classes="notice proceed" IsVisible="{Binding ShowDone}" Margin="0,0,0,16">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Ellipse Classes="lamp" />
          <TextBlock Grid.Column="1" Classes="text"
                     Text="You're all set: links from other apps now follow your rules. This page leaves the sidebar once you move on." />
          <Button Grid.Column="2" Classes="ghost" Content="Go to rules" Command="{Binding OpenRulesCommand}" Margin="12,0,0,0" />
        </Grid>
      </Border>

      <!-- The steps that get links routing. Done steps shrink to their title; only the next step's button is the accent. -->
      <StackPanel IsVisible="{Binding ShowSteps}">
        <TextBlock Classes="h2" Text="Get links routing" Margin="12,0,0,4" />
        <TextBlock Classes="body muted" Margin="12,0,0,16" MaxWidth="640" HorizontalAlignment="Left" TextWrapping="Wrap"
                   Text="{Binding StepsIntro}" />

        <!-- 1. Browsers -->
        <Border Classes="row step" Padding="12,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Classes="junction" Classes.done="{Binding Rules.HasBrowsers}">
              <Panel>
                <TextBlock Text="1" IsVisible="{Binding Rules.NeedsBrowsers}" />
                <c:Icon Data="{StaticResource Icon.Check}" IsVisible="{Binding Rules.HasBrowsers}" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
              <TextBlock Text="Find your browsers" FontWeight="SemiBold" />
              <TextBlock Classes="small muted" Text="{Binding Rules.BrowsersStepDetail}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Classes.accent="{Binding BrowsersNext}"
                    Command="{Binding Rules.FindBrowsersCommand}" IsVisible="{Binding Rules.NeedsBrowsers}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{StaticResource Icon.Browsers}" />
                <TextBlock Text="Find browsers" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- 2. First rule -->
        <Border Classes="row step" Padding="12,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Classes="junction" Classes.done="{Binding Rules.HasRules}">
              <Panel>
                <TextBlock Text="2" IsVisible="{Binding NeedsRule}" />
                <c:Icon Data="{StaticResource Icon.Check}" IsVisible="{Binding Rules.HasRules}" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
              <TextBlock Text="Add your first rule" FontWeight="SemiBold" />
              <TextBlock Classes="small muted" TextWrapping="Wrap" IsVisible="{Binding NeedsRule}"
                         Text="A pattern and the browser it opens in. You can also save one from the window that asks where an unmatched link should open." />
            </StackPanel>
            <Button Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Classes.accent="{Binding RuleNext}"
                    Command="{Binding AddRuleCommand}" IsEnabled="{Binding Rules.HasBrowsers}" IsVisible="{Binding NeedsRule}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{StaticResource Icon.Plus}" />
                <TextBlock Text="Add rule" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- 3. Default browser: without it no link ever reaches NudgeJudge. Done here, not by a trip to Settings. -->
        <Border Classes="row step" Padding="12,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Classes="junction" Classes.done="{Binding Settings.IsRegistered}">
              <Panel>
                <TextBlock Text="3" IsVisible="{Binding !Settings.IsRegistered}" />
                <c:Icon Data="{StaticResource Icon.Check}" IsVisible="{Binding Settings.IsRegistered}" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
              <TextBlock Text="Make NudgeJudge your default browser" FontWeight="SemiBold" />
              <TextBlock Classes="small muted" TextWrapping="Wrap" IsVisible="{Binding !Settings.IsRegistered}"
                         Text="So links from mail, chat and the terminal come here first. Until then, they skip NudgeJudge and your rules never run." />
              <TextBlock Classes="small" TextWrapping="Wrap" Margin="0,4,0,0" IsVisible="{Binding ShowRegistrationMessage}"
                         Text="{Binding Settings.RegistrationMessage}" />
            </StackPanel>
            <Panel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
              <Button Classes.accent="{Binding DefaultNext}" Command="{Binding Settings.RegisterCommand}"
                      IsVisible="{Binding Settings.CanRegister}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Data="{StaticResource Icon.Shield}" />
                  <TextBlock Text="Make default" />
                </StackPanel>
              </Button>
              <Button Classes.accent="{Binding DefaultNext}" Content="Open setup" Command="{Binding OpenSetupCommand}"
                      IsVisible="{Binding ShowOpenSetup}" />
            </Panel>
          </Grid>
        </Border>

        <!-- 4. Only when someone switched routing off: it's on out of the box, so it isn't a step otherwise -->
        <Border Classes="row step" Padding="12,12" IsVisible="{Binding ShowRoutingStep}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Classes="junction">
              <TextBlock Text="4" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
              <TextBlock Text="Turn routing on" FontWeight="SemiBold" />
              <TextBlock Classes="small muted" Text="{Binding RoutingStepDetail}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Classes.accent="{Binding RoutingNext}"
                    Content="Turn routing on" Command="{Binding Rules.TurnOnRoutingCommand}" />
          </Grid>
        </Border>

        <TextBlock Classes="small faint" Margin="12,12,0,0" MaxWidth="640" HorizontalAlignment="Left" TextWrapping="Wrap"
                   IsVisible="{Binding ShowRoutingNote}"
                   Text="Routing is already on. The Routing switch at the foot of the sidebar pauses your rules without deleting them." />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
