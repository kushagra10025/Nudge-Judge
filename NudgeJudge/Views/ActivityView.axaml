<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NudgeJudge.ViewModels"
             xmlns:c="using:NudgeJudge.Controls"
             x:Class="NudgeJudge.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="32,28,32,0">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Activity" />
        <TextBlock Classes="muted" FontSize="13" Text="{Binding CountText, StringFormat='Every link NudgeJudge handled, newest first · {0}'}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="ghost" Command="{Binding ClearCommand}" IsEnabled="{Binding !IsEmpty}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Data="{StaticResource Icon.Trash}" />
          <TextBlock Text="Clear" />
        </StackPanel>
      </Button>
    </Grid>

    <TextBox Grid.Row="1" Text="{Binding Filter}" PlaceholderText="Filter by link, rule or browser" MaxWidth="420"
             HorizontalAlignment="Left" Margin="0,0,0,12" IsVisible="{Binding !IsEmpty}"
             AutomationProperties.Name="Filter activity">
      <TextBox.InnerLeftContent>
        <c:Icon Data="{StaticResource Icon.Search}" Margin="10,0,2,0" Foreground="{DynamicResource InkFaintBrush}" />
      </TextBox.InnerLeftContent>
    </TextBox>

    <ScrollViewer Grid.Row="2" Padding="0,0,0,24">
      <Panel>
        <StackPanel IsVisible="{Binding IsEmpty}" Spacing="6" Margin="12,32" HorizontalAlignment="Left" MaxWidth="480">
          <TextBlock Classes="h2" Text="Nothing routed yet" />
          <TextBlock Classes="body muted"
                     Text="When another app opens a link, it shows up here along with the rule that handled it, or the browser you picked." />
        </StackPanel>
        <StackPanel IsVisible="{Binding NoFilterResults}" Spacing="8" Margin="12,24" HorizontalAlignment="Left">
          <TextBlock Classes="muted" Text="{Binding Filter, StringFormat='Nothing matches “{0}”.'}" />
          <Button Classes="ghost" Content="Clear filter" Command="{Binding ClearFilterCommand}" Padding="8,4" Margin="-8,0,0,0" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ActivityItemViewModel">
              <Border Classes="row" Margin="0,0,0,2">
                <Grid ColumnDefinitions="72,84,*">
                  <TextBlock Classes="mono faint small" Text="{Binding Time}" VerticalAlignment="Top" Margin="0,2,0,0"
                             ToolTip.Tip="{Binding FullTime}" />
                  <Panel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Border Classes="badge route" IsVisible="{Binding IsRouted}"><TextBlock Text="{Binding OutcomeLabel}" /></Border>
                    <Border Classes="badge" IsVisible="{Binding IsAsked}"><TextBlock Text="{Binding OutcomeLabel}" /></Border>
                    <Border Classes="badge stop" IsVisible="{Binding IsProblem}"><TextBlock Text="{Binding OutcomeLabel}" /></Border>
                  </Panel>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="{Binding Host}" FontWeight="SemiBold" />
                    <SelectableTextBlock Classes="mono faint" FontSize="12" Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="small muted" Text="{Binding RouteText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>
