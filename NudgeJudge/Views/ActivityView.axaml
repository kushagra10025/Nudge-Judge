<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NudgeJudge.ViewModels"
             xmlns:v="using:NudgeJudge.Views"
             xmlns:c="using:NudgeJudge.Controls"
             x:Class="NudgeJudge.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="32,28,32,0">
    <v:UndoToast Grid.RowSpan="4" ZIndex="1" DataContext="{Binding Undo}" />
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Activity" />
        <TextBlock Classes="muted" FontSize="13" Text="{Binding CountText, StringFormat='Every link NudgeJudge handled, newest first · {0}'}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="ghost" Command="{Binding ClearCommand}" IsEnabled="{Binding !IsEmpty}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Data="{StaticResource Icon.Trash}" />
          <TextBlock Text="Clear" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Logging off with history still showing: say why nothing new appears -->
    <Border Grid.Row="1" Classes="notice" IsVisible="{Binding ShowLoggingOffNotice}" Margin="0,0,0,12"
            HorizontalAlignment="Left" MaxWidth="640">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Ellipse Classes="lamp" />
        <TextBlock Grid.Column="1" Classes="text" Text="Activity logging is off, so new links aren't recorded." />
        <Button Grid.Column="2" Classes="ghost" Content="Turn on" Command="{Binding TurnOnLoggingCommand}" Margin="12,0,0,0" />
      </Grid>
    </Border>

    <TextBox Grid.Row="2" Text="{Binding Filter}" PlaceholderText="Filter by link, rule, browser or app" MaxWidth="420"
             HorizontalAlignment="Left" Margin="0,0,0,12" IsVisible="{Binding !IsEmpty}"
             AutomationProperties.Name="Filter activity">
      <TextBox.InnerLeftContent>
        <c:Icon Data="{StaticResource Icon.Search}" Margin="10,0,2,0" Foreground="{DynamicResource InkFaintBrush}" />
      </TextBox.InnerLeftContent>
    </TextBox>

    <ScrollViewer Grid.Row="3" Padding="0,0,0,24">
      <Panel>
        <StackPanel IsVisible="{Binding ShowEmptyHint}" Spacing="6" Margin="12,32" HorizontalAlignment="Left" MaxWidth="480">
          <TextBlock Classes="h2" Text="Nothing routed yet" />
          <TextBlock Classes="body muted"
                     Text="When another app opens a link, it shows up here along with the rule that handled it, or the browser you picked." />
          <StackPanel Spacing="10" Margin="0,8,0,0" IsVisible="{Binding Settings.NeedsSetup}">
            <TextBlock Classes="body muted"
                       Text="Links only arrive once NudgeJudge is your default browser." />
            <Button Content="Open setup" Command="{Binding OpenSetupCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowLoggingOffEmpty}" Spacing="6" Margin="12,32" HorizontalAlignment="Left" MaxWidth="480">
          <TextBlock Classes="h2" Text="Activity logging is off" />
          <TextBlock Classes="body muted"
                     Text="Links still route as usual, but NudgeJudge doesn't keep a record of them." />
          <Button Content="Turn on" Command="{Binding TurnOnLoggingCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel IsVisible="{Binding NoFilterResults}" Spacing="8" Margin="12,24" HorizontalAlignment="Left">
          <TextBlock Classes="muted" Text="{Binding Filter, StringFormat='Nothing matches “{0}”.'}" />
          <Button Classes="ghost" Content="Clear filter" Command="{Binding ClearFilterCommand}" Padding="8,4" Margin="-8,0,0,0" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ActivityItemViewModel">
              <Border Classes="row" Margin="0,0,0,2">
                <Grid ColumnDefinitions="72,96,*,Auto">
                  <TextBlock Classes="mono faint small" Text="{Binding Time}" VerticalAlignment="Top" Margin="0,2,0,0"
                             ToolTip.Tip="{Binding FullTime}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,4,0,0">
                    <Panel Width="8" Height="8" VerticalAlignment="Center">
                      <Ellipse Classes="status" Fill="{DynamicResource RouteBrush}" IsVisible="{Binding IsRouted}" />
                      <Ellipse Classes="status" Fill="{DynamicResource InkBrush}" IsVisible="{Binding IsChosen}" />
                      <Ellipse Classes="status" Stroke="{DynamicResource InkFaintBrush}" StrokeThickness="1.5" IsVisible="{Binding IsAsked}" />
                      <Ellipse Classes="status" Fill="{DynamicResource StopBrush}" IsVisible="{Binding IsProblem}" />
                    </Panel>
                    <TextBlock Classes="small muted" Text="{Binding OutcomeLabel}" Classes.error="{Binding IsProblem}"
                               VerticalAlignment="Center" FontWeight="Medium" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <!-- Host, then the app the link came from: rules can route on either -->
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="{Binding Host}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*" Margin="10,0,0,0" IsVisible="{Binding HasSource}"
                            ToolTip.Tip="{Binding SourceDetail}" VerticalAlignment="Center">
                        <TextBlock Classes="small faint" Text="from" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <c:Icon Grid.Column="1" Data="{StaticResource Icon.App}" Width="12" Height="12" StrokeThickness="2"
                                Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Grid.Column="2" Classes="small muted" Text="{Binding SourceName}" FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   AutomationProperties.Name="Opened from" />
                      </Grid>
                    </Grid>
                    <SelectableTextBlock Classes="mono faint" FontSize="12" Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="small muted" TextWrapping="Wrap">
                      <Run Text="{Binding RoutePrefix}" /><Run Text="{Binding RouteName}" Foreground="{DynamicResource InkBrush}" /><Run Text="{Binding RoutePattern}" FontFamily="{StaticResource MonoFont}" /><Run Text="{Binding RouteSuffix}" />
                    </TextBlock>
                    <TextBlock Classes="small faint" TextWrapping="Wrap" IsVisible="{Binding TiedToLauncher}"
                               Text="Handled by a NudgeJudge that closes with the program that started it"
                               ToolTip.Tip="Usually your browser: its extension had to start NudgeJudge, and NudgeJudge couldn't run separately from it, so it closes when the browser does. Start NudgeJudge yourself, or turn on Launch at startup, so one runs on its own." />
                  </StackPanel>
                  <!-- Shown on hover and keyboard focus (Styles.axaml) -->
                  <!-- The fix for a link held back by an imported browser: shown at rest, like a row's error -->
                  <Button Grid.Column="3" Classes="ghost" Command="{Binding ReviewBrowserCommand}" IsVisible="{Binding CanReviewBrowser}"
                          VerticalAlignment="Top" Margin="12,0,0,0" ToolTip.Tip="Open this browser to check its program and arguments"
                          AutomationProperties.Name="Review browser">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Data="{StaticResource Icon.Edit}" />
                      <TextBlock Text="Review browser" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="3" Classes="ghost actions" Command="{Binding CreateRuleCommand}" IsVisible="{Binding ShowCreateRule}"
                          VerticalAlignment="Top" Margin="12,0,0,0" ToolTip.Tip="Start a rule for links like this one"
                          AutomationProperties.Name="Create rule from this link">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Data="{StaticResource Icon.Plus}" />
                      <TextBlock Text="Create rule" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>
