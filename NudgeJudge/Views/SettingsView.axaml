<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NudgeJudge.ViewModels"
             xmlns:c="using:NudgeJudge.Controls"
             x:Class="NudgeJudge.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <Style Selector="Grid.setting">
      <Setter Property="Margin" Value="20,16" />
    </Style>
    <!-- Cards span the page like the other lists; descriptions keep a readable measure -->
    <Style Selector="Grid.setting TextBlock.body">
      <Setter Property="MaxWidth" Value="600" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Grid.setting > StackPanel">
      <Setter Property="Margin" Value="0,0,24,0" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
      <Setter Property="Margin" Value="4,28,0,8" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="32,28,32,32">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Settings" />
        <TextBlock Classes="muted" FontSize="13" Text="Changes save as you make them." />
      </StackPanel>

      <!-- First, because nothing else works until links reach NudgeJudge -->
      <TextBlock Classes="section" Text="Default browser" />
      <Border Classes="surface">
        <Grid Classes="setting" ColumnDefinitions="Auto,*,Auto">
          <Panel Width="10" Height="10" Margin="0,5,12,0" VerticalAlignment="Top">
            <Ellipse Fill="{DynamicResource ProceedBrush}" IsVisible="{Binding IsRegistered}" />
            <Ellipse Stroke="{DynamicResource InkFaintBrush}" StrokeThickness="1.5" IsVisible="{Binding NeedsSetup}" />
          </Panel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Classes="label" Text="NudgeJudge is your default browser" IsVisible="{Binding IsRegistered}" />
            <TextBlock Classes="label" Text="NudgeJudge isn't your default browser yet" IsVisible="{Binding NeedsSetup}" />
            <TextBlock Classes="label" Text="Checking the default browser…" IsVisible="{Binding !RegistrationChecked}" />
            <TextBlock Classes="body muted" Text="{Binding RegistrationMessage}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="accent" Command="{Binding RegisterCommand}" VerticalAlignment="Center" Margin="16,0,0,0"
                  IsVisible="{Binding CanRegister}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource Icon.Shield}" />
              <TextBlock Text="Make default" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <TextBlock Classes="section" Text="Routing" />
      <Border Classes="surface">
        <StackPanel>
          <Grid Classes="setting" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Route links by rules" />
              <TextBlock Classes="body muted" Text="When off, every link opens in the primary browser and rules are ignored." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding RoutingEnabled}" OnContent="On" OffContent="Off" />
          </Grid>
          <Rectangle Classes="divider" />
          <Grid Classes="setting" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Primary browser" />
              <TextBlock Classes="body muted" Text="Used when routing is off. With none set, links go to the chooser." />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Browsers}" SelectedItem="{Binding PrimaryBrowser}"
                      MinWidth="220" VerticalAlignment="Center" PlaceholderText="None" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="Chooser" />
      <Border Classes="surface">
        <StackPanel>
          <Grid Classes="setting" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Group links that arrive together" />
              <TextBlock Classes="body muted" Text="Unmatched links within this many seconds of each other queue as tabs instead of jumping ahead." />
            </StackPanel>
            <NumericUpDown Grid.Column="1" Value="{Binding ChooserGroupingSeconds}" Minimum="0" Maximum="120" Increment="1"
                           FormatString="0' s'" MinWidth="140" VerticalAlignment="Center" />
          </Grid>
          <Rectangle Classes="divider" />
          <Grid Classes="setting" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Temporary rule length" />
              <TextBlock Classes="body muted" Text="How long a rule saved with ‘For N hours’ lasts." />
            </StackPanel>
            <NumericUpDown Grid.Column="1" Value="{Binding TemporaryRuleHours}" Minimum="1" Maximum="168" Increment="1"
                           FormatString="0' h'" MinWidth="140" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="Activity" />
      <Border Classes="surface">
        <StackPanel>
          <Grid Classes="setting" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Keep an activity log" />
              <TextBlock Classes="body muted" Text="Records each link and where it went, and keeps the log between runs. When off, nothing new is recorded." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ActivityLogEnabled}" OnContent="On" OffContent="Off"
                          AutomationProperties.Name="Keep an activity log" />
          </Grid>
          <Rectangle Classes="divider" />
          <Grid Classes="setting" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Entries to keep" />
              <TextBlock Classes="body muted" Text="Once the log is longer than this, the oldest entries are deleted." />
            </StackPanel>
            <NumericUpDown Grid.Column="1" Value="{Binding ActivityLogLimit}" Minimum="{Binding MinActivityLogLimit}"
                           Maximum="{Binding MaxActivityLogLimit}" Increment="10" FormatString="0" MinWidth="140"
                           VerticalAlignment="Center" IsEnabled="{Binding ActivityLogEnabled}"
                           AutomationProperties.Name="Activity entries to keep" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="App" />
      <Border Classes="surface">
        <StackPanel>
          <Grid Classes="setting" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Keep running in the tray" />
              <TextBlock Classes="body muted" Text="Closing this window leaves NudgeJudge running so links keep routing. Quit from the tray menu." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding RunInBackground}" OnContent="On" OffContent="Off" />
          </Grid>
          <Rectangle Classes="divider" />
          <Grid Classes="setting" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Launch at startup" />
              <TextBlock Classes="body muted" Text="Starts NudgeJudge in the tray when you sign in, so links route from the first click."
                         IsVisible="{Binding CanLaunchAtStartup}" />
              <TextBlock Classes="body muted" Text="Launching at startup isn't available on this system yet."
                         IsVisible="{Binding !CanLaunchAtStartup}" />
              <TextBlock Classes="body" Foreground="{DynamicResource StopBrush}" Text="{Binding StartupMessage}"
                         TextWrapping="Wrap" IsVisible="{Binding HasStartupMessage}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchAtStartup}" OnContent="On" OffContent="Off"
                          IsEnabled="{Binding CanLaunchAtStartup}" AutomationProperties.Name="Launch at startup" />
          </Grid>
          <Rectangle Classes="divider" />
          <Grid Classes="setting" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Appearance" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="180" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="Updates" />
      <Border Classes="surface" DataContext="{Binding Updates}" x:DataType="vm:UpdatesViewModel" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel>
          <Grid Classes="setting" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="Check for updates automatically" />
              <TextBlock Classes="body muted" Text="Looks for a new release on GitHub. Nothing is downloaded until you choose to update." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckAutomatically}" OnContent="On" OffContent="Off"
                          IsEnabled="{Binding IsSupported}" AutomationProperties.Name="Check for updates automatically" />
          </Grid>
          <Rectangle Classes="divider" />
          <Grid Classes="setting" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="How often" />
              <TextBlock Classes="body muted" Text="While NudgeJudge stays in the tray, daily and weekly checks still run on time." />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" MinWidth="180"
                      VerticalAlignment="Center" AutomationProperties.Name="How often to check for updates">
              <ComboBox.IsEnabled>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="IsSupported" />
                  <Binding Path="CheckAutomatically" />
                </MultiBinding>
              </ComboBox.IsEnabled>
            </ComboBox>
          </Grid>
          <Rectangle Classes="divider" />
          <Grid Classes="setting" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="{Binding StatusText}" TextWrapping="Wrap" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="label" Text="{Binding CurrentVersion, StringFormat='Version {0}'}"
                         IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
              <TextBlock Classes="body muted" Text="{Binding LastCheckedText}" IsVisible="{Binding IsSupported}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="accent" Command="{Binding UpdateCommand}" IsVisible="{Binding HasUpdate}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Data="{StaticResource Icon.Down}" />
                  <TextBlock Text="{Binding UpdateLabel}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding CheckNowCommand}" IsVisible="{Binding !HasUpdate}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Data="{StaticResource Icon.Refresh}" />
                  <TextBlock Text="Check now" />
                </StackPanel>
              </Button>
            </StackPanel>
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Minimum="0" Maximum="100" Value="{Binding Progress}"
                         IsIndeterminate="{Binding !IsDownloading}" IsVisible="{Binding IsBusy}" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="section" Text="Files" />
      <Border Classes="surface">
        <StackPanel>
          <Grid Classes="setting" RowDefinitions="Auto,Auto">
            <TextBlock Classes="label" Text="Configuration file" />
            <SelectableTextBlock Grid.Row="1" Classes="mono" FontSize="12" Foreground="{DynamicResource InkMutedBrush}"
                                 Text="{Binding ConfigPath}" Margin="0,4,0,0" TextWrapping="Wrap" />
          </Grid>
          <Rectangle Classes="divider" />
          <Grid Classes="setting" RowDefinitions="Auto,Auto">
            <TextBlock Classes="label" Text="Activity log" />
            <SelectableTextBlock Grid.Row="1" Classes="mono" FontSize="12" Foreground="{DynamicResource InkMutedBrush}"
                                 Text="{Binding ActivityLogPath}" Margin="0,4,0,0" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Last: who made this and where it lives -->
      <TextBlock Classes="section" Text="About" />
      <Border Classes="surface">
        <Grid Classes="setting" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
          <Image Source="/Assets/nudgejudge.png" Width="48" Height="48" Margin="0,2,16,0" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="label" Text="NudgeJudge" FontSize="15" />
              <TextBlock Classes="muted mono" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,1"
                         Text="{Binding AppVersion, StringFormat='v{0}'}" />
            </StackPanel>
            <TextBlock Classes="body muted" TextWrapping="Wrap"
                       Text="A browser router: every link goes to the browser or profile your rules pick, or to a quick chooser when none do." />
            <TextBlock Classes="body muted" Text="© 2026 Kushagra · MIT License" Margin="0,6,0,0" />
          </StackPanel>
          <WrapPanel Grid.Row="1" Grid.Column="1" Margin="-8,8,0,0">
            <HyperlinkButton Content="Source on GitHub" NavigateUri="{Binding RepositoryUrl}" />
            <HyperlinkButton Content="Release notes" NavigateUri="{Binding ReleasesUrl}" />
            <HyperlinkButton Content="Report a problem" NavigateUri="{Binding IssuesUrl}" />
            <HyperlinkButton Content="License" NavigateUri="{Binding LicenseUrl}" />
          </WrapPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
