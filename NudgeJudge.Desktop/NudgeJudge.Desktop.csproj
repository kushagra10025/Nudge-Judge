<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Native AOT: `dotnet publish -r linux-x64` (or win-x64) compiles the app to machine code ahead of time.
    A launch that only routes a link then opens the browser in ~20 ms instead of ~250 ms, with no JIT.
    `dotnet build` and `dotnet run` still use the JIT; the AOT analyzers flag incompatible code in both.
  -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <!-- Most launches route one link and exit: skip creating the background GC thread. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- The AOT linker defaults to clang; use gcc where clang isn't installed. -->
    <CppCompilerAndLinker Condition="'$(OS)' != 'Windows_NT' And !Exists('/usr/bin/clang')">gcc</CppCompilerAndLinker>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\NudgeJudge\Assets\nudgejudge.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NudgeJudge\NudgeJudge.csproj" />
    <!-- The tray host, started from here. Referenced so a build puts its executable next to this one. -->
    <ProjectReference Include="..\NudgeJudge.Tray\NudgeJudge.Tray.csproj" />
  </ItemGroup>

  <!-- A publish of this app is both programs in one folder: publish the tray host (natively too) next to it. -->
  <Target Name="PublishTrayHost" AfterTargets="Publish">
    <MSBuild Projects="..\NudgeJudge.Tray\NudgeJudge.Tray.csproj" Targets="Publish"
             Properties="PublishDir=$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))" />
  </Target>
</Project>
